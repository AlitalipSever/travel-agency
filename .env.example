# Copy to api/.env for docker compose and the laptop. Names only; never commit real values.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Data stores (docker compose service names; on the laptop use localhost)
DATABASE_URL=postgres://travel:travel@postgres:5432/travel
REDIS_URL=redis://redis:6379/0

# Weather upstream (W1 to W4). Leave empty to run in mock mode with recorded payloads.
OPENWEATHER_API_KEY=

# Refresh and budget (06 §8)
REFRESH_INTERVAL_S=900
UPSTREAM_REFRESH_SHARE=40
UPSTREAM_ADHOC_SHARE=8
ADHOC_RATE_PER_MIN=30
BREAKER_FAILURES=5
BREAKER_COOLDOWN_S=60
GIT_COMMIT=                      # reported by /api/v1/ops/status; the image build sets it
CHART_VERSION=                   # set by the Helm chart

# Case study site (web)
API_URL=http://api:8000                    # internal URL the site's server calls
NEXT_PUBLIC_API_URL=http://localhost:8000  # public API origin, for the Swagger UI link
API_PUBLIC_URL=                            # same, read at runtime (the cluster sets it; empty on compose)
DEMO_PARTNER_TOKEN=                        # demo-partner token printed by `make demo`; never in git
